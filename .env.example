# --- MySQL (primary structured store) ---
# Put your real password in .env (gitignored). Do not commit secrets.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=assetiq

# --- Dataset paths ---
# Sample dataset (already cloned)
ASSETIQ_DATA_ROOT=C:\Users\DELL\Desktop\flytbase-ahc-swe-asset-intelligence-dataset\sample-data
# Optional second dataset folder (same format) — loads alongside sample
# ASSETIQ_TEST_DATA_ROOT=C:\path\to\test-dataset\sample-data

# --- Gemma 4 (reasoning / tool use) ---
# Hosted via Gemini API (free Gemma 4)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
# GEMINI_MODEL_STRONG=gemma-4-31b-it

# Local via Ollama (default open-weight path)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Which backend to try first: ollama | gemini
ASSETIQ_LLM_BACKEND=ollama
# Keep local model loaded between questions (Turbo Mode)
OLLAMA_KEEP_ALIVE=30m
# Cap explanation length for snappier streams
ASSETIQ_MAX_TOKENS=320
# Answer cache for repeat demo questions (1=on)
ASSETIQ_CACHE=1
# Seconds before falling back to deterministic summary (demo must never hang)
ASSETIQ_LLM_TIMEOUT=45
# Set to 1 to skip Gemma and return deterministic envelopes only
# ASSETIQ_SKIP_LLM=0

